android_app {
  name: "OmniJaws",
  manifest: "app/src/main/AndroidManifest.xml",
  sdk_version: "system_current",
  system_ext_specific: true,

  libs: [
    "org.apache.http.legacy",
  ],

  srcs: [
    "app/src/main/**/*.java",
  ],

  resource_dirs: [
    "app/src/main/res/",
  ],

  static_libs: [
    "androidx.core_core",
    "androidx.preference_preference",
    "com.google.android.material_material",
    "OmniPreferenceTheme"
  ],
  
  optimize: {
    enabled: false,
  },
  required: [
      "privapp_whitelist_org.omnirom.omnijaws-ext",
  ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.omnirom.omnijaws-ext",
    sub_dir: "permissions",
    src: "privapp_whitelist_org.omnirom.omnijaws-ext.xml",
    filename_from_src: true,
}
